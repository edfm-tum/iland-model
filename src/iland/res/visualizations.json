// =============================================================================
// iLand built-in output visualization definitions (JSONC)
// =============================================================================
// Users can override any entry (by matching "id") or add custom visualizations
// by placing a "visualizations.json" file in either:
//   1) the iLand executable directory (applies to all projects), or
//   2) the project directory next to the XML project file.
// See README_visualizations.md (or click "?" in Output options)
// for the complete metadata reference.
{
  "version": 1,
  "visualizations": [
    // -------------------------------------------------------------------------
    // 1. Landscape timelines
    // -------------------------------------------------------------------------
    {
      "id": "landscape_species_shares",
      "name": "Species shares",
      "category": "Landscape timelines",
      "description": "Landscape-level forest development per species (stacked area).",
      "table": "landscape",
      "type": "stacked_area",
      "allowPercentToggle": true,
      "x": "year",
      "xLabel": "Year",
      "group": "species",
      "colorMode": "species",
      "metricsMode": "select",
      "metrics": [
        { "col": "basal_area_m2",   "label": "Basal area (m²/ha)" },
        { "col": "volume_m3",       "label": "Volume (m³/ha)" },
        { "col": "count_ha",        "label": "Stem count (n/ha)" },
        { "col": "LAI",             "label": "Leaf area index (m²/m²)" },
        { "col": "total_carbon_kg", "label": "Total living carbon (kg C/ha)" },
        { "col": "NPP_kg",          "label": "NPP (kg DM/ha)" },
        { "col": "NPPabove_kg",     "label": "Aboveground NPP (kg DM/ha)" },
        { "col": "gwl_m3",          "label": "Cumulative volume growth GWL (m³/ha)" },
        { "col": "cohort_count_ha", "label": "Regeneration cohorts (n/ha)" }
      ],
      "sql": "SELECT year, species, basal_area_m2, volume_m3, count_ha, LAI, total_carbon_kg, NPP_kg, NPPabove_kg, gwl_m3, cohort_count_ha FROM landscape ORDER BY year, species"
    },
    {
      "id": "landscape_species_lines",
      "name": "Species trajectories",
      "category": "Landscape timelines",
      "description": "Landscape-level variables per species as lines (including non-additive mean DBH and height).",
      "table": "landscape",
      "type": "line",
      "x": "year",
      "xLabel": "Year",
      "group": "species",
      "colorMode": "species",
      "metricsMode": "select",
      "metrics": [
        { "col": "basal_area_m2",   "label": "Basal area (m²/ha)" },
        { "col": "volume_m3",       "label": "Volume (m³/ha)" },
        { "col": "dbh_avg_cm",      "label": "Mean DBH (cm)" },
        { "col": "height_avg_m",    "label": "Mean height (m)" },
        { "col": "count_ha",        "label": "Stem count (n/ha)" },
        { "col": "LAI",             "label": "Leaf area index (m²/m²)" },
        { "col": "NPP_kg",          "label": "NPP (kg DM/ha)" },
        { "col": "cohort_count_ha", "label": "Regeneration cohorts (n/ha)" }
      ],
      "sql": "SELECT year, species, basal_area_m2, volume_m3, dbh_avg_cm, height_avg_m, count_ha, LAI, NPP_kg, cohort_count_ha FROM landscape ORDER BY year, species"
    },
    {
      "id": "landscape_removed_by_reason",
      "name": "Removals & mortality by cause",
      "category": "Landscape timelines",
      "description": "Removed trees across the landscape grouped by cause (natural, harvest, disturbance, salvage, cut).",
      "table": "landscape_removed",
      "type": "stacked_bar",
      "allowPercentToggle": true,
      "fillMissingYears": true,
      "x": "year",
      "xLabel": "Year",
      "group": "reason",
      "groupLabels": {
        "N": "Natural mortality",
        "H": "Harvest",
        "D": "Disturbance (unsalvaged)",
        "S": "Salvage harvest",
        "C": "Cut down (mgmt)"
      },
      "groupColors": {
        "N": "#6a3d9a",
        "H": "#1b7837",
        "D": "#e31a1c",
        "S": "#ff7f00",
        "C": "#a6cee3"
      },
      "metricsMode": "select",
      "metrics": [
        { "col": "volume_m3",     "label": "Removed volume (m³)" },
        { "col": "basal_area_m2", "label": "Removed basal area (m²)" },
        { "col": "count",         "label": "Removed trees (count)" },
        { "col": "total_carbon",  "label": "Removed carbon (kg C)" }
      ],
      "sql": [
        "SELECT year, reason,",
        "  SUM(volume_m3) AS volume_m3,",
        "  SUM(basal_area_m2) AS basal_area_m2,",
        "  SUM(count) AS count,",
        "  SUM(total_carbon) AS total_carbon",
        "FROM landscape_removed",
        "GROUP BY year, reason ORDER BY year, reason"
      ]
    },
    {
      "id": "landscape_removed_by_species",
      "name": "Removals & mortality by species",
      "category": "Landscape timelines",
      "description": "Removed trees across the landscape grouped by species (filtered by removal cause).",
      "table": "landscape_removed",
      "type": "stacked_bar",
      "allowPercentToggle": true,
      "fillMissingYears": true,
      "x": "year",
      "xLabel": "Year",
      "group": "species",
      "colorMode": "species",
      "filters": ["reason"],
      "groupLabels": {
        "N": "Natural mortality",
        "H": "Harvest",
        "D": "Disturbance (unsalvaged)",
        "S": "Salvage harvest",
        "C": "Cut down (mgmt)"
      },
      "metricsMode": "select",
      "metrics": [
        { "col": "volume_m3",     "label": "Removed volume (m³)" },
        { "col": "basal_area_m2", "label": "Removed basal area (m²)" },
        { "col": "count",         "label": "Removed trees (count)" },
        { "col": "total_carbon",  "label": "Removed carbon (kg C)" }
      ],
      "sql": [
        "SELECT year, species,",
        "  SUM(volume_m3) AS volume_m3,",
        "  SUM(basal_area_m2) AS basal_area_m2,",
        "  SUM(count) AS count,",
        "  SUM(total_carbon) AS total_carbon",
        "FROM landscape_removed",
        "WHERE reason = :reason",
        "GROUP BY year, species ORDER BY year, species"
      ]
    },
    {
      "id": "devstage_landscape",
      "name": "Stand development stages",
      "category": "Landscape timelines",
      "description": "Landscape share (%) of forest development stages over time.",
      "table": "devstage",
      "type": "stacked_area",
      "allowPercentToggle": false,
      "x": "year",
      "xLabel": "Year",
      "group": "stage",
      "metricsMode": "select",
      "metrics": [
        { "col": "percent_area", "label": "Landscape share (%)" },
        { "col": "ncells",       "label": "Number of cells" }
      ],
      "sql": "SELECT year, stage, percent_area, ncells FROM devstage ORDER BY year, stage"
    },
    {
      "id": "carbon_pools_landscape",
      "name": "Ecosystem carbon pools (landscape)",
      "category": "Landscape timelines",
      "description": "Landscape-mean ecosystem carbon pools (soil, litter, deadwood, roots, regeneration, stem, branches+foliage).",
      "table": "carbon",
      "type": "stacked_area",
      "allowPercentToggle": true,
      "x": "year",
      "xLabel": "Year",
      "yLabel": "Carbon (t C/ha)",
      "metricsMode": "all",
      "metrics": [
        { "col": "soil_t",       "label": "Soil (SOM)",        "color": "#543005" },
        { "col": "litter_t",     "label": "Litter",            "color": "#bf812d" },
        { "col": "dwd_t",        "label": "Downed deadwood",   "color": "#dfc27d" },
        { "col": "snags_t",      "label": "Standing snags",    "color": "#878787" },
        { "col": "roots_t",      "label": "Coarse+fine roots", "color": "#d95f02" },
        { "col": "regen_t",      "label": "Regeneration",      "color": "#a6dba0" },
        { "col": "stem_t",       "label": "Stem",              "color": "#1b7837" },
        { "col": "branch_fol_t", "label": "Branches+foliage",  "color": "#5aae61" },
        { "col": "understorey_t","label": "Understorey/moss",  "color": "#80cdc1" }
      ],
      "sql": [
        "SELECT year,",
        "  soil_c / 1000.0 AS soil_t,",
        "  litter_c / 1000.0 AS litter_t,",
        "  downedWood_c / 1000.0 AS dwd_t,",
        "  (snags_c + snagsOther_c) / 1000.0 AS snags_t,",
        "  (coarseRoot_c + fineRoot_c) / 1000.0 AS roots_t,",
        "  regeneration_c / 1000.0 AS regen_t,",
        "  stem_c / 1000.0 AS stem_t,",
        "  (branch_c + foliage_c) / 1000.0 AS branch_fol_t,",
        "  understorey_c / 1000.0 AS understorey_t",
        "FROM carbon WHERE ru = -1 ORDER BY year"
      ]
    },
    {
      "id": "nitrogen_pools_landscape",
      "name": "Ecosystem nitrogen pools (landscape)",
      "category": "Landscape timelines",
      "description": "Landscape-mean ecosystem nitrogen pools (kg N/ha).",
      "table": "carbon",
      "type": "stacked_area",
      "allowPercentToggle": true,
      "x": "year",
      "xLabel": "Year",
      "yLabel": "Nitrogen (kg N/ha)",
      "metricsMode": "all",
      "metrics": [
        { "col": "soil_n",        "label": "Soil (SOM)",        "color": "#543005" },
        { "col": "litter_n",      "label": "Litter",            "color": "#bf812d" },
        { "col": "downedWood_n",  "label": "Downed deadwood",   "color": "#dfc27d" },
        { "col": "snags_n_tot",   "label": "Standing snags",    "color": "#878787" },
        { "col": "roots_n",       "label": "Coarse+fine roots", "color": "#d95f02" },
        { "col": "regeneration_n","label": "Regeneration",      "color": "#a6dba0" },
        { "col": "stem_n",        "label": "Stem",              "color": "#1b7837" },
        { "col": "branch_fol_n",  "label": "Branches+foliage",  "color": "#5aae61" }
      ],
      "sql": [
        "SELECT year, soil_n, litter_n, downedWood_n,",
        "  (snags_n + snagsOther_n) AS snags_n_tot,",
        "  (coarseRoot_n + fineRoot_n) AS roots_n,",
        "  regeneration_n, stem_n,",
        "  (branch_n + foliage_n) AS branch_fol_n",
        "FROM carbon WHERE ru = -1 ORDER BY year"
      ]
    },
    {
      "id": "carbon_fluxes_landscape",
      "name": "Carbon fluxes (landscape)",
      "category": "Landscape timelines",
      "description": "Landscape-mean annual carbon fluxes (positive = uptake, negative = ecosystem loss).",
      "table": "carbonflow",
      "type": "line",
      "x": "year",
      "xLabel": "Year",
      "yLabel": "Carbon flux (kg C/ha/yr)",
      "metricsMode": "all",
      "metrics": [
        { "col": "GPP",       "label": "GPP",              "color": "#1b7837" },
        { "col": "NPP",       "label": "NPP",              "color": "#66bd63" },
        { "col": "Rh",        "label": "Heterotrophic Rh", "color": "#8c510a" },
        { "col": "dist_loss", "label": "Disturbance loss", "color": "#e31a1c" },
        { "col": "mgmt_loss", "label": "Management loss",  "color": "#ff7f00" },
        { "col": "NEP",       "label": "NEP",              "color": "#1f78b4" }
      ],
      "sql": "SELECT year, GPP, NPP, Rh, dist_loss, mgmt_loss, NEP FROM carbonflow WHERE ru = -1 ORDER BY year"
    },
    {
      "id": "carbon_cumulative_landscape",
      "name": "Cumulative carbon balance (landscape)",
      "category": "Landscape timelines",
      "description": "Cumulative NPP, heterotrophic respiration (Rh), and net ecosystem productivity (NEP) across the landscape.",
      "table": "carbonflow",
      "type": "line",
      "x": "year",
      "xLabel": "Year",
      "yLabel": "Cumulative C (kg C/ha)",
      "metricsMode": "all",
      "metrics": [
        { "col": "cumNPP", "label": "Cumulative NPP", "color": "#1b7837" },
        { "col": "cumRh",  "label": "Cumulative Rh",  "color": "#8c510a" },
        { "col": "cumNEP", "label": "Cumulative NEP", "color": "#1f78b4" }
      ],
      "sql": "SELECT year, cumNPP, cumRh, cumNEP FROM carbonflow WHERE ru = -1 ORDER BY year"
    },
    {
      "id": "water_balance_landscape",
      "name": "Water balance (landscape)",
      "category": "Landscape timelines",
      "description": "Landscape-mean precipitation, evapotranspiration, lateral outflow/excess, and soil water content.",
      "table": "water",
      "type": "line",
      "x": "year",
      "xLabel": "Year",
      "yLabel": "Water (mm)",
      "metricsMode": "all",
      "metrics": [
        { "col": "precipitation_mm", "label": "Precipitation (mm)",     "color": "#1f78b4" },
        { "col": "et_mm",            "label": "ET (mm)",                "color": "#33a02c" },
        { "col": "excess_mm",        "label": "Outflow / excess (mm)",  "color": "#a6cee3" },
        { "col": "mean_swc_mm",      "label": "Mean SWC (mm)",          "color": "#ff7f00" },
        { "col": "mean_swc_gs_mm",   "label": "Growing season SWC (mm)","color": "#e31a1c" }
      ],
      "sql": "SELECT year, precipitation_mm, et_mm, excess_mm, mean_swc_mm, mean_swc_gs_mm FROM water WHERE ru = -1 ORDER BY year"
    },
    {
      "id": "water_climate_permafrost_landscape",
      "name": "Climate, snow & permafrost (landscape)",
      "category": "Landscape timelines",
      "description": "Landscape-mean temperature, snow cover, effective LAI, and permafrost depth metrics.",
      "table": "water",
      "type": "line",
      "x": "year",
      "xLabel": "Year",
      "metricsMode": "select",
      "metrics": [
        { "col": "mean_annual_temp", "label": "Mean annual temp (°C)",      "color": "#e31a1c" },
        { "col": "snowcover_days",   "label": "Snow cover (days)",          "color": "#1f78b4" },
        { "col": "effective_lai",    "label": "Effective LAI (m²/m²)",      "color": "#1b7837" },
        { "col": "total_radiation",  "label": "Total radiation (MJ/m²)",    "color": "#ff7f00" },
        { "col": "maxDepthFrozen",   "label": "Max freezing depth (m)",     "color": "#2b8cbe" },
        { "col": "maxDepthThawed",   "label": "Max thawing depth (m)",      "color": "#8c510a" },
        { "col": "maxSnowCover",     "label": "Max snow cover (m)",         "color": "#7bccc4" },
        { "col": "SOLLayer",         "label": "Soil organic layer (m)",     "color": "#543005" }
      ],
      "sql": "SELECT year, mean_annual_temp, snowcover_days, effective_lai, total_radiation, maxDepthFrozen, maxDepthThawed, maxSnowCover, SOLLayer FROM water WHERE ru = -1 ORDER BY year"
    },

