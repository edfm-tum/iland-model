      "table": "production_month",
      "type": "boxplot",
      "x": "month",
      "xLabel": "Month",
      "xCategories": ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"],
      "filters": ["species", "ru"],
      "metricsMode": "select",
      "metrics": [
        { "col": "waterResponse",          "label": "Soil water response (0..1)" },
        { "col": "tempResponse",           "label": "Temperature response (0..1)" },
        { "col": "vpdResponse",            "label": "VPD response (0..1)" },
        { "col": "co2Response",            "label": "CO2 response" },
        { "col": "phenology",              "label": "Phenology fraction (0..1)" },
        { "col": "GPP_kg_m2",              "label": "Monthly GPP (kg/m²)" },
        { "col": "utilizableRadiation_m2", "label": "Utilizable PAR (MJ/m²)" },
        { "col": "radiation_m2",           "label": "Global radiation PAR (MJ/m²)" }
      ],
      "sql": [
        "SELECT month, waterResponse, tempResponse, vpdResponse, co2Response,",
        "  phenology, GPP_kg_m2, utilizableRadiation_m2, radiation_m2",
        "FROM production_month WHERE species = :species AND ru = :ru ORDER BY month"
      ]
    },
    {
      "id": "production_month_timeline",
      "name": "3PG monthly responses (timeline)",
      "category": "Resource unit timelines",
      "description": "Monthly 3PG response and GPP trajectory over simulation time.",
      "table": "production_month",
      "type": "line",
      "x": "time",
      "xLabel": "Year",
      "filters": ["species", "ru"],
      "metricsMode": "select",
      "metrics": [
        { "col": "waterResponse",          "label": "Soil water response (0..1)", "color": "#1f78b4" },
        { "col": "tempResponse",           "label": "Temperature response (0..1)", "color": "#e31a1c" },
        { "col": "vpdResponse",            "label": "VPD response (0..1)",        "color": "#ff7f00" },
        { "col": "GPP_kg_m2",              "label": "Monthly GPP (kg/m²)",        "color": "#1b7837" },
        { "col": "utilizableRadiation_m2", "label": "Utilizable PAR (MJ/m²)",     "color": "#6a3d9a" }
      ],
      "sql": [
        "SELECT year + (month - 0.5) / 12.0 AS time,",
        "  waterResponse, tempResponse, vpdResponse, GPP_kg_m2, utilizableRadiation_m2",
        "FROM production_month WHERE species = :species AND ru = :ru ORDER BY year, month"
      ]
    },

    // -------------------------------------------------------------------------
    // 3. Disturbances & management
    // -------------------------------------------------------------------------
    {
      "id": "fire_disturbance",
      "name": "Fire disturbance",
      "category": "Disturbances & management",
      "description": "Annual wildfire burned area, fire count, and tree mortality.",
      "table": "fire",
      "type": "bar",
      "fillMissingYears": true,
      "x": "year",
      "xLabel": "Year",
      "metricsMode": "select",
      "metrics": [
        { "col": "burned_ha",    "label": "Burned area (ha)",       "color": "#e31a1c" },
        { "col": "n_fires",      "label": "Number of fires",        "color": "#ff7f00" },
        { "col": "killed_ba_m2", "label": "Killed basal area (m²)", "color": "#8c510a" },
        { "col": "killed_trees", "label": "Killed trees (count)",   "color": "#6a3d9a" }
      ],
      "sql": [
        "SELECT year,",
        "  SUM(area_m2) / 10000.0 AS burned_ha,",
        "  COUNT(*) AS n_fires,",
        "  SUM(basalArea_died) AS killed_ba_m2,",
        "  SUM(n_trees_died) AS killed_trees",
        "FROM fire GROUP BY year ORDER BY year"
      ]
    },
    {
      "id": "wind_disturbance",
      "name": "Wind disturbance",
      "category": "Disturbances & management",
      "description": "Annual storm-affected area, killed volume, and peak wind speed.",
      "table": "wind",
      "type": "bar",
      "fillMissingYears": true,
      "x": "year",
      "xLabel": "Year",
      "metricsMode": "select",
      "metrics": [
        { "col": "area_ha",         "label": "Affected area (ha)",      "color": "#1f78b4" },
        { "col": "killedVolume",    "label": "Killed volume (m³)",      "color": "#e31a1c" },
        { "col": "killedBasalArea", "label": "Killed basal area (m²)",  "color": "#ff7f00" },
        { "col": "killedTrees",     "label": "Killed trees (count)",    "color": "#6a3d9a" },
        { "col": "windspeed_ms",    "label": "Wind speed (m/s)",        "color": "#01665e" }
      ],
      "sql": [
        "SELECT year,",
        "  SUM(area_ha) AS area_ha,",
        "  SUM(killedVolume) AS killedVolume,",
        "  SUM(killedBasalArea) AS killedBasalArea,",
        "  SUM(killedTrees) AS killedTrees,",
        "  MAX(windspeed_ms) AS windspeed_ms",
        "FROM wind GROUP BY year ORDER BY year"
      ]
    },
    {
      "id": "barkbeetle_dynamics",
      "name": "Bark beetle dynamics",
      "category": "Disturbances & management",
      "description": "Annual bark beetle infested/killed area and killed Norway spruce volume.",
      "table": "barkbeetle",
      "type": "line",
      "x": "year",
      "xLabel": "Year",
      "metricsMode": "select",
      "metrics": [
        { "col": "killedVolume",          "label": "Killed volume (m³)",           "color": "#8c510a" },
        { "col": "killedArea_ha",         "label": "Killed area (ha)",             "color": "#e31a1c" },
        { "col": "infestedArea_ha",       "label": "Newly infested area (ha)",     "color": "#ff7f00" },
        { "col": "killedTrees",           "label": "Killed trees (count)",         "color": "#6a3d9a" },
        { "col": "stormActivation_ha",    "label": "Storm-activated area (ha)",    "color": "#1f78b4" },
        { "col": "backgroundActivation_ha","label": "Background activation (ha)",  "color": "#33a02c" }
      ],
      "sql": [
        "SELECT year,",
        "  SUM(killedVolume) AS killedVolume,",
        "  SUM(killedArea_ha) AS killedArea_ha,",
        "  SUM(infestedArea_ha) AS infestedArea_ha,",
        "  SUM(killedTrees) AS killedTrees,",
        "  SUM(stormActivation_ha) AS stormActivation_ha,",
        "  SUM(backgroundActivation_ha) AS backgroundActivation_ha",
        "FROM barkbeetle GROUP BY year ORDER BY year"
      ]
    },
    {
      "id": "abe_unit_harvests",
      "name": "ABE planned vs. realized harvest",
      "category": "Disturbances & management",
      "description": "Planned harvest targets and realized final, thinning, and salvage harvests per planning unit.",
      "table": "abeUnit",
      "type": "line",
      "x": "year",
      "xLabel": "Year",
      "yLabel": "Timber volume (m³/ha/yr)",
      "filters": ["id"],
      "metricsMode": "all",
      "metrics": [
        { "col": "decadePlan",      "label": "Decade plan",       "color": "#7f7f7f" },
        { "col": "annualPlan",      "label": "Annual plan",       "color": "#1f78b4" },
        { "col": "realizedHarvest", "label": "Realized total",    "color": "#1b7837" },
        { "col": "finalHarvest",    "label": "Final harvest",     "color": "#33a02c" },
        { "col": "thinningHarvest", "label": "Thinning harvest",  "color": "#a6cee3" },
        { "col": "salvageHarvest",  "label": "Salvage harvest",   "color": "#ff7f00" }
      ],
      "sql": "SELECT year, decadePlan, annualPlan, realizedHarvest, finalHarvest, thinningHarvest, salvageHarvest FROM abeUnit WHERE id = :id ORDER BY year"
    },
    {
      "id": "abe_unit_growing_stock",
      "name": "ABE growing stock & MAI",
      "category": "Disturbances & management",
      "description": "Standing volume, mean annual increment (MAI), and mean age per ABE planning unit (updated decadal).",
      "table": "abeUnit",
      "type": "line",
      "x": "year",
      "xLabel": "Year",
      "filters": ["id"],
      "metricsMode": "select",
      "metrics": [
        { "col": "volume", "label": "Mean standing volume (m³/ha)", "color": "#1b7837" },
        { "col": "MAI",    "label": "Mean annual increment (m³/ha/yr)", "color": "#1f78b4" },
        { "col": "age",    "label": "Mean stand age (years)", "color": "#8c510a" }
      ],
      "sql": "SELECT year, volume, MAI, age FROM abeUnit WHERE id = :id ORDER BY year"
    },
    {
      "id": "abe_removals_by_activity",
      "name": "ABE harvests by activity",
      "category": "Disturbances & management",
      "description": "Area-weighted harvested and disturbed timber volume grouped by ABE management activity.",
      "table": "abeStandRemoval",
      "type": "stacked_bar",
      "fillMissingYears": true,
      "x": "year",
      "xLabel": "Year",
      "group": "activity",
      "metricsMode": "select",
      "metrics": [
        { "col": "total_harvest_m3", "label": "Harvested volume (m³)" },
        { "col": "thinning_m3",      "label": "Thinning volume (m³)" },
        { "col": "final_m3",         "label": "Final harvest volume (m³)" },
        { "col": "salvaged_m3",      "label": "Salvaged volume (m³)" },
        { "col": "disturbed_m3",     "label": "Disturbed volume (m³)" }
      ],
      "sql": [
        "SELECT year, COALESCE(NULLIF(activity, ''), '(none)') AS activity,",
        "  SUM((volumeThinning + volumeFinal + volumeSalvaged) * area) AS total_harvest_m3,",
        "  SUM(volumeThinning * area) AS thinning_m3,",
        "  SUM(volumeFinal * area) AS final_m3,",
        "  SUM(volumeSalvaged * area) AS salvaged_m3,",
        "  SUM(volumeDisturbed * area) AS disturbed_m3",
        "FROM abeStandRemoval",
        "GROUP BY year, activity ORDER BY year, activity"
      ]
    },
    {
      "id": "bite_agent_summary",
      "name": "BITE biotic agent summary",
      "category": "Disturbances & management",
      "description": "Annual spread, colonization, and tree/sapling impact for a selected BITE agent.",
      "table": "bite",
      "type": "line",
      "x": "year",
      "xLabel": "Year",
      "filters": ["agent"],
      "metricsMode": "select",
      "metrics": [
        { "col": "NColonized",      "label": "Colonized cells (n)",     "color": "#e31a1c" },
        { "col": "NNewlyColonized", "label": "Newly colonized cells",   "color": "#ff7f00" },
        { "col": "treesKilled",     "label": "Trees killed (count)",    "color": "#6a3d9a" },
        { "col": "volumeKilled",    "label": "Volume killed (m³)",      "color": "#8c510a" },
        { "col": "totalImpact",     "label": "Total impact",            "color": "#1f78b4" },
        { "col": "saplingKilled",   "label": "Sapling cohorts killed",  "color": "#33a02c" }
      ],
      "sql": "SELECT year, NColonized, NNewlyColonized, treesKilled, volumeKilled, totalImpact, saplingKilled FROM bite WHERE agent = :agent ORDER BY year"
    },

    // -------------------------------------------------------------------------
    // 4. Spatial maps (RU)
    // -------------------------------------------------------------------------
    {
      "id": "dominant_species_spatial_map",
      "name": "Dominant species map (RU)",
      "category": "Spatial maps (RU)",
      "description": "Dominant tree species per resource unit (dashed fill where dominant species share is <50%).",
      "table": "stand",
      "type": "spatial",
      "spatialKey": "rid",
      "speciesMode": "dominant",
      "metricsMode": "select",
      "metrics": [
        { "col": "basal_area_m2",   "label": "Basal area (m²/ha)" },
        { "col": "volume_m3",       "label": "Volume (m³/ha)" },
        { "col": "count_ha",        "label": "Stem count (n/ha)" },
        { "col": "LAI",             "label": "Leaf area index (m²/m²)" },
        { "col": "total_carbon_kg", "label": "Living carbon (kg C/ha)" },
        { "col": "NPP_kg",          "label": "NPP (kg DM/ha)" },
        { "col": "cohort_count_ha", "label": "Regen cohorts (n/ha)" }
      ],
      "sql": "SELECT year, ru, rid, species, basal_area_m2, volume_m3, count_ha, LAI, total_carbon_kg, NPP_kg, cohort_count_ha FROM stand"
    },
    {
      "id": "stand_spatial_map",
      "name": "Stand map (RU)",
      "category": "Spatial maps (RU)",
      "description": "Spatial distribution of stand volume, basal area, LAI, stem count, or mean dimensions per resource unit.",
      "table": "stand",
      "type": "spatial",
      "spatialKey": "rid",
      "palette": "turbo",
      "speciesMode": "select_with_aggregates",
      "metricsMode": "select",
      "metrics": [
        { "col": "volume_m3",       "label": "Volume (m³/ha)",          "agg": "sum" },
        { "col": "basal_area_m2",   "label": "Basal area (m²/ha)",      "agg": "sum" },
        { "col": "LAI",             "label": "Leaf area index (m²/m²)", "agg": "sum" },
        { "col": "count_ha",        "label": "Stem count (n/ha)",       "agg": "sum" },
        { "col": "total_carbon_kg", "label": "Living carbon (kg C/ha)", "agg": "sum" },
        { "col": "NPP_kg",          "label": "NPP (kg DM/ha)",          "agg": "sum" },
        { "col": "cohort_count_ha", "label": "Regen cohorts (n/ha)",    "agg": "sum" },
        { "col": "dbh_avg_cm",      "label": "Mean DBH (cm)",           "agg": "none" },
        { "col": "height_avg_m",    "label": "Mean height (m)",         "agg": "none" }
      ],
      "sql": "SELECT year, ru, rid, species, volume_m3, basal_area_m2, LAI, count_ha, total_carbon_kg, NPP_kg, cohort_count_ha, dbh_avg_cm, height_avg_m FROM stand"
    },
    {
      "id": "sapling_spatial_map",
      "name": "Regeneration map (RU)",
      "category": "Spatial maps (RU)",
      "description": "Spatial distribution of saplings and regeneration cohorts per resource unit.",
      "table": "sapling",
      "type": "spatial",
      "spatialKey": "rid",
      "palette": "greens",
      "speciesMode": "select_with_aggregates",
      "metricsMode": "select",
      "metrics": [
        { "col": "count_ha",        "label": "Saplings >1.3m (n/ha)",        "agg": "sum" },
        { "col": "count_small_ha",  "label": "Small saplings <=1.3m (n/ha)", "agg": "sum" },
        { "col": "cohort_count_ha", "label": "Cohorts (n/ha)",               "agg": "sum" },
        { "col": "LAI",             "label": "Sapling LAI (m²/m²)",          "agg": "sum" },
        { "col": "height_avg_m",    "label": "Mean sapling height (m)",      "agg": "none" },
        { "col": "age_avg",         "label": "Mean sapling age (years)",     "agg": "none" }
      ],
      "sql": "SELECT year, ru, rid, species, count_ha, count_small_ha, cohort_count_ha, LAI, height_avg_m, age_avg FROM sapling"
    },
    {
      "id": "carbon_spatial_map",
      "name": "Carbon pools map (RU)",
      "category": "Spatial maps (RU)",
      "description": "Spatial distribution of total, live aboveground, deadwood, and soil carbon pools (t C/ha).",
      "table": "carbon",
      "type": "spatial",
      "spatialKey": "rid",
      "palette": "greens",
      "metricsMode": "select",
      "metrics": [
        { "col": "total_t",    "label": "Total ecosystem C (t C/ha)" },
        { "col": "live_ag_t",  "label": "Live aboveground C (t C/ha)" },
        { "col": "deadwood_t", "label": "Snags + downed wood C (t C/ha)" },
        { "col": "soil_t",     "label": "Soil + litter C (t C/ha)" },
        { "col": "stem_t",     "label": "Stem C (t C/ha)" }
      ],
      "sql": [
        "SELECT year, ru, rid,",
        "  (stem_c + branch_c + foliage_c + coarseRoot_c + fineRoot_c + regeneration_c + snags_c + snagsOther_c + downedWood_c + litter_c + soil_c + understorey_c) / 1000.0 AS total_t,",
        "  (stem_c + branch_c + foliage_c + regeneration_c) / 1000.0 AS live_ag_t,",
        "  (snags_c + snagsOther_c + downedWood_c) / 1000.0 AS deadwood_t,",
        "  (soil_c + litter_c) / 1000.0 AS soil_t,",
        "  stem_c / 1000.0 AS stem_t",
        "FROM carbon WHERE ru >= 0"
      ]
    },
    {
      "id": "carbonflow_spatial_map",
      "name": "Carbon fluxes map (RU)",
      "category": "Spatial maps (RU)",
      "description": "Spatial distribution of annual GPP, NPP, Rh, and NEP across resource units.",
      "table": "carbonflow",
      "type": "spatial",
      "spatialKey": "rid",
      "palette": "turbo",
      "metricsMode": "select",
      "metrics": [
        { "col": "NPP",    "label": "NPP (kg C/ha/yr)" },
        { "col": "GPP",    "label": "GPP (kg C/ha/yr)" },
        { "col": "NEP",    "label": "NEP (kg C/ha/yr)" },
        { "col": "Rh",     "label": "Heterotrophic Rh (kg C/ha/yr)" },
        { "col": "cumNEP", "label": "Cumulative NEP (kg C/ha)" }
      ],
      "sql": "SELECT year, ru, rid, NPP, GPP, NEP, Rh, cumNEP FROM carbonflow WHERE ru >= 0"
    },
    {
      "id": "water_spatial_map",
      "name": "Water & permafrost map (RU)",
      "category": "Spatial maps (RU)",
      "description": "Spatial variation in evapotranspiration, soil water, temperature, snow, and permafrost across resource units.",
      "table": "water",
      "type": "spatial",
      "spatialKey": "rid",
      "palette": "blues",
      "metricsMode": "select",
      "metrics": [
        { "col": "et_mm",            "label": "Evapotranspiration (mm)" },
        { "col": "mean_swc_gs_mm",   "label": "Growing season SWC (mm)" },
        { "col": "excess_mm",        "label": "Lateral outflow / excess (mm)" },
        { "col": "precipitation_mm", "label": "Precipitation (mm)" },
        { "col": "mean_annual_temp", "label": "Mean annual temp (°C)" },
        { "col": "effective_lai",    "label": "Effective LAI (m²/m²)" },
        { "col": "snowcover_days",   "label": "Snow cover (days)" },
        { "col": "maxDepthThawed",   "label": "Permafrost max thaw depth (m)" },
        { "col": "maxDepthFrozen",   "label": "Permafrost max freeze depth (m)" }
      ],
      "sql": "SELECT year, ru, rid, et_mm, mean_swc_gs_mm, excess_mm, precipitation_mm, mean_annual_temp, effective_lai, snowcover_days, maxDepthThawed, maxDepthFrozen FROM water WHERE ru >= 0"
    },
    {
      "id": "standdead_spatial_map",
      "name": "Mortality map (RU)",
      "category": "Spatial maps (RU)",
      "description": "Annual tree mortality per resource unit.",
      "table": "standdead",
      "type": "spatial",
      "spatialKey": "rid",
      "palette": "reds",
      "speciesMode": "select_with_aggregates",
      "metricsMode": "select",
      "metrics": [
        { "col": "volume_m3",     "label": "Dead volume (m³/ha)",     "agg": "sum" },
        { "col": "basal_area_m2", "label": "Dead basal area (m²/ha)", "agg": "sum" },
        { "col": "count_ha",      "label": "Dead trees (n/ha)",       "agg": "sum" }
      ],
      "sql": "SELECT year, ru, rid, species, volume_m3, basal_area_m2, count_ha FROM standdead"
    },
    {
      "id": "management_spatial_map",
      "name": "Management removals map (RU)",
      "category": "Spatial maps (RU)",
      "description": "Annual harvested/removed timber per resource unit.",
      "table": "management",
      "type": "spatial",
      "spatialKey": "rid",
      "palette": "reds",
      "speciesMode": "select_with_aggregates",
      "metricsMode": "select",
      "metrics": [
        { "col": "volume_m3",     "label": "Removed volume (m³/ha)",     "agg": "sum" },
        { "col": "basal_area_m2", "label": "Removed basal area (m²/ha)", "agg": "sum" },
        { "col": "count_ha",      "label": "Removed trees (n/ha)",       "agg": "sum" }
      ],
      "sql": "SELECT year, ru, rid, species, volume_m3, basal_area_m2, count_ha FROM management"
    }
  ]
}
